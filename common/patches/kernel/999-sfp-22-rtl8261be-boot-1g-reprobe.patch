+static void sfp_fixup_oem_10gt_i(struct sfp *sfp)
+{
+	/* The same rev A module after it has switched to 1000BASE-X for a 1G
+	 * link partner. Its EEPROM already describes it correctly; only watch
+	 * for a later cable change back to 10G.
+	 */
+	if (!memcmp(sfp->id.base.vendor_rev, "A   ", 4))
+		sfp->reprobe_no_link = true;
+}
