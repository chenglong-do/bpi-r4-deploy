+static struct net_device *sfp_upstream_netdev(struct sfp *sfp)
+{
+	struct net_device *ndev;
+
+	ASSERT_RTNL();
+
+	if (!sfp->sfp_bus)
+		return NULL;
+
+	for_each_netdev(&init_net, ndev)
+		if (ndev->sfp_bus == sfp->sfp_bus)
+			return ndev;
+
+	return NULL;
+}
+
+static void sfp_reprobe(struct work_struct *work)
+{
+	struct sfp *sfp = container_of(work, struct sfp, reprobe.work);
+	struct net_device *ndev;
+
+	rtnl_lock();
+	mutex_lock(&sfp->sm_mutex);
+
+	/* Signal lost meanwhile: the LOS handling re-arms us. */
+	if (sfp->sm_state != SFP_S_LINK_UP || !sfp->sm_reprobe_tries)
+		goto unlock;
+
+	/* The module reports signal; only the host link tells whether the
+	 * selected interface matches what the module speaks now. Without a
+	 * netdev to ask, leave the module alone.
+	 */
+	ndev = sfp_upstream_netdev(sfp);
+	if (!ndev || netif_carrier_ok(ndev)) {
+		sfp->sm_link_ok = true;
+		goto unlock;
+	}
+
+	sfp->sm_reprobe_tries--;
+	dev_info(sfp->dev,
+		 "%s: no link, re-reading module (%u tries left)\n",
+		 netdev_name(ndev), sfp->sm_reprobe_tries);
+
+	/* Replicate a physical remove/insert so the module is re-read and the
+	 * upstream interface is re-selected from its current advertisement.
+	 */
+	sfp->sm_reprobing = true;
+	__sfp_sm_event(sfp, SFP_E_REMOVE);
+	__sfp_sm_event(sfp, SFP_E_INSERT);
+
+unlock:
+	mutex_unlock(&sfp->sm_mutex);
+	rtnl_unlock();
+}
